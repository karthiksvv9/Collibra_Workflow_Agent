        <flowNodeRef>submit_request</flowNodeRef>
        <flowNodeRef>requester_rework</flowNodeRef>
        <flowNodeRef>end_approved</flowNodeRef>
        <flowNodeRef>end_rejected</flowNodeRef>
      </lane>
      <lane id="lane_Data_Steward" name="Data Steward">
        <flowNodeRef>steward_triage</flowNodeRef>
        <flowNodeRef>gateway_steward_decision</flowNodeRef>
      </lane>
      <lane id="lane_Business_Owner" name="Business Owner">
        <flowNodeRef>business_approval</flowNodeRef>
        <flowNodeRef>gateway_business_decision</flowNodeRef>
      </lane>
      <lane id="lane_Risk_and_Compliance" name="Risk and Compliance">
        <flowNodeRef>risk_compliance_review</flowNodeRef>
        <flowNodeRef>gateway_compliance_decision</flowNodeRef>
      </lane>
      <lane id="lane_Collibra_Automation" name="Collibra Automation">
        <flowNodeRef>validate_context</flowNodeRef>
        <flowNodeRef>gateway_request_complete</flowNodeRef>
        <flowNodeRef>gateway_risk_route</flowNodeRef>
        <flowNodeRef>gateway_policy_exception</flowNodeRef>
        <flowNodeRef>create_policy_exception</flowNodeRef>
        <flowNodeRef>create_relations</flowNodeRef>
        <flowNodeRef>update_access_status</flowNodeRef>
